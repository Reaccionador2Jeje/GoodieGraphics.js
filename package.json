{
  "name": "goodiegraphics.js",
  "version": "1.0.0",
  "description": "A complete creative 3D toolkit for the web, powered by Three.js.",
  "type": "module",
  "license": "BSD-3-Clause",
  "keywords": [
    "3d",
    "threejs",
    "graphics",
    "webgl",
    "game-development",
    "3d-editor",
    "world-builder",
    "procedural-modeling",
    "3d-model-builder",
    "animation",
    "gltf",
    "obj",
    "fbx",
    "web-3d"
  ],
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js"
    },
    "./*": "./src/*"
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "index.d.ts",
    "CHANGELOG.md",
    "index.html",
    "studio.html",
    "vite.config.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/studio/studio.js"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  },
  "types": "./index.d.ts",
  "sideEffects": false
}
